# ── Native (C++ / CMake) ──────────────────────────────────────────────
/Native/build/
# Named variant trees produced by build.sh/build.bat and the CI gate commands
# (build-host-image-on, build-root-release-threaded-on, build-ci-policy, ...).
/Native/build-*/
/Native/out/
/Native/cmake-build-*/
# CI-only vendored software rasterizer trees (never committed).
/Native/swiftshader-source/
/Native/swiftshader-build/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.pdb

# ── Core (Java / Gradle) ──────────────────────────────────────────────
/Core/.gradle/
/Core/build/
/Core/**/build/
!/Core/gradle/wrapper/gradle-wrapper.jar

# ── Mod (Java / Gradle) ───────────────────────────────────────────────
/Mod/.gradle/
/Mod/build/
/Mod/**/build/
/Mod/gradle-app.setting
!/Mod/gradle/wrapper/gradle-wrapper.jar

# ── Editor (TypeScript / Node / Electron) ─────────────────────────────
/Editor/node_modules/
/Editor/dist/
/Editor/out/
/Editor/release/
/Editor/.vite/
/Editor/coverage/
*.tsbuildinfo

# ── Coverage / test reports ───────────────────────────────────────────
/**/coverage/
/**/*.gcda
/**/*.gcno

# ── IDE / OS ──────────────────────────────────────────────────────────
/.worktrees/
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

/**/ref/
/vibe-docs/ref-analyze/

vibe-docs/claude/project-brief.md
